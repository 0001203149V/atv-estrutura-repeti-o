let numero;
do {
    numero = parseInt(prompt("Digite um número entre 1 e 10:"));
    if (numero < 1 || numero > 10 || isNaN(numero)){
        alert("Número inválido, tente novamente.");
    }
} while (numero<1 || numero > 10 || isNaN(numero));
alert(`Parabéns, você digitou o número válido: ${numero}`);
